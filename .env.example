# Set your Gemini API key from https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

# Set your GitHub token (from `gh auth token` or https://github.com/settings/tokens with 'repo' scope)
GH_TOKEN=your_github_token_here

PORT=8080

# GitHub repository where generated projects will be published
GITHUB_OUTPUT_REPO=remote-code-agent-output
